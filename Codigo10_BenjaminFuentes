#include <stdio.h>

int numeros[5];
int suma = 0;

int main() {
    int i, promedio;

    for (i = 0; i < 5; i++) {
        printf("Ingrese un numero:\n");
        scanf("%d", &numeros[i]);
    }

    for (i = 0; i < 5; i++) {
        suma += numeros[i];
    }

    promedio = suma / 5;

    printf("La suma de los numeros es: %d\n", suma);
    printf("El promedio es: %d\n", promedio);

    return 0;
}
