#include <stdio.h>

int numeros[3][2];

int main() {
    int fila, columna;

    for (fila = 0; fila < 3; fila++) {
        for (columna = 0; columna < 2; columna++) {
            printf("Ingrese un numero en la fila %d, columna %d:\n", fila, columna);
            scanf("%d", &numeros[fila][columna]);
        }
    }

    printf("Matriz ingresada:\n");

    for (fila = 0; fila < 3; fila++) {
        for (columna = 0; columna < 2; columna++) {
            printf("%d\t", numeros[fila][columna]);
        }
        printf("\n");
    }

    return 0;
}
