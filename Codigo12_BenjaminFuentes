#include <stdio.h>

int numeros1[5], numeros2[5];

void comparar(int a[], int b[]) {
    int i;

    for (i = 0; i < 5; i++) {
        if (a[i] > b[i]) {
            printf("En la posicion %d, el mayor es %d y pertenece al primer vector\n", i, a[i]);
        }
        else if (b[i] > a[i]) {
            printf("En la posicion %d, el mayor es %d y pertenece al segundo vector\n", i, b[i]);
        }
        else {
            printf("En la posicion %d, ambos numeros son iguales: %d\n", i, a[i]);
        }
    }
}

int main() {
    int i;

    printf("Ingrese los valores del primer vector:\n");

    for (i = 0; i < 5; i++) {
        printf("Valor de la posicion %d:\n", i);
        scanf("%d", &numeros1[i]);
    }

    printf("Ingrese los valores del segundo vector:\n");

    for (i = 0; i < 5; i++) {
        printf("Valor de la posicion %d:\n", i);
        scanf("%d", &numeros2[i]);
    }

    comparar(numeros1, numeros2);

    return 0;
}
